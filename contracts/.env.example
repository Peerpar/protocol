## Contract Environment Variables

# ── Deployment ──────────────────────────────────────────────────────────────

# Private key of the deployer wallet (hex, no 0x prefix)
# WARNING: Never commit this file with a real key present.
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# The EOA that will be authorised to call anchor() on-chain.
# In production this should be DIFFERENT from DEPLOYER_PRIVATE_KEY.
RELAYER_ADDRESS=0xYourRelayerAddressHere

# ── RPC Endpoints ────────────────────────────────────────────────────────────

RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_POLYGON_ZKEVM_TESTNET=https://rpc.cardona.zkevm-rpc.com
RPC_URL_POLYGON_ZKEVM=https://zkevm-rpc.com

# ── Block Explorer API Keys (for contract verification) ──────────────────────
BASESCAN_API_KEY=your_basescan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ── Optional: gas reporter ────────────────────────────────────────────────────
REPORT_GAS=false
CMC_API_KEY=
