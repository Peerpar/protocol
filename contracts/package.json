{
    "name": "peerpar-contracts",
    "version": "0.1.0",
    "private": true,
    "description": "PeerPar Protocol — Solidity smart contracts for proof-of-existence anchoring",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "test:gas": "REPORT_GAS=true hardhat test",
        "deploy:local": "hardhat run scripts/deploy.js --network localhost",
