## Relayer Environment Variables
# WARNING: Never commit this file to version control with real values.

# ── Required ───────────────────────────────────────────────────────────────
# Private key of the EOA that pays gas for anchor() calls.
# This should be a DEDICATED wallet — do not reuse your deployer key.
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# The deployed ProofRegistry contract address
CONTRACT_ADDRESS=0xYourContractAddressHere

# RPC endpoint for the target chain
RPC_URL=https://sepolia.base.org

# Chain ID: 84532=Base Sepolia, 8453=Base, 2442=Polygon zkEVM Testnet, 1101=Polygon zkEVM
CHAIN_ID=84532

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins (leave empty to allow all)
# In production, set this to your portal URL + any other known callers
ALLOWED_ORIGINS=https://verify.peerpar.io
